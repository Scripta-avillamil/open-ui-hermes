# OpenClaw Gateway (legacy, no longer needed with Hermes integration)
OPENCLAW_GATEWAY_URL=http://localhost:8645
OPENCLAW_API_KEY=any-token
OPENCLAW_MODEL=nous

# Hermes Integration
HERMES_BIN=hermes
HERMES_TIMEOUT=120000

# App
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
DATABASE_URL=file:./chat.db

# App Config
NODE_ENV=production
PORT=3000
